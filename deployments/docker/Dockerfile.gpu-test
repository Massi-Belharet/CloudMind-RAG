# Throwaway smoke test — verifies torch.cuda.is_available() works inside a
# container with GPU passthrough, BEFORE building the real backend image.
#
# The --index-url below is copied verbatim from pyproject.toml's
# [tool.uv.sources] / [[tool.uv.index]] block (torch pinned to the cu124
# wheel index) — do not change it here without updating pyproject.toml too.
FROM python:3.13-slim

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu124

CMD ["python", "-c", "import torch; print('CUDA available:', torch.cuda.is_available()); print('Device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'N/A')"]
